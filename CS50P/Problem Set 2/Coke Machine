def main():
    coke = 50     
    print(f"Amount Due: {coke}")

    while coke > 0:
        change = int(input("Insert Coin: "))

        if change in [5, 10, 25]:
            coke -= change 
            if coke > 0:
                print(f"Amount Due: {coke}")
            else:
                print(f"Change Owed: {abs(coke)}")
        else:
            print(f"Amount Due: {coke}")

main()
