type_applications = (".pdf", ".txt", ".zip")

# asks users for the file name and stripes errors for spaces or capitalisation
name = input("File Name: ")
file_name = name.strip(" ").casefold()

if file_name.endswith((".gif", ".jpeg", ".png")):
     print(f"image/{name.split('.')[-1]}")

elif file_name.endswith((".jpg")):
     print("image/jpeg")

elif file_name.endswith((".pdf", ".zip")):
    print(f"application/{file_name.split('.')[-1]}")

elif file_name.endswith(".txt"):
    print("text/plain")

else:
    print("application/octet-stream")
