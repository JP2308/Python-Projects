expression = input("Expression: ")

x, y, z = expression.split(" ")

if y == "+":
    result = int(x) + int(z)
    print("{:.1f}".format(result))

elif y == "/":
    result = int(x) / int(z)
    print("{:.1f}".format(result))

elif y == "*":
    result =  int(x) * int(z)
    print("{:.1f}".format(result))

else:
    result = int(x) - int(z)
    print("{:.1f}".format(result))
