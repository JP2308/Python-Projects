# This is the higher level logic of the program
def main():
    dollars = dollars_to_float(input("How much was the meal? "))
    percent = percent_to_float(input("What percentage would you like to tip? "))
    tip = dollars * percent
    print(f"Leave ${tip:.2f}")

def dollars_to_float(d):
    # stripes $ from the input
    d = float(d.strip('$'))
    # store the value so tip can be calculated
    return d


def percent_to_float(p):
    # stripes % from the input
    p = float(p.strip('%'))/100
    # store the value so tip can be calculated
    return p



main()
